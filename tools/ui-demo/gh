#!/usr/bin/env python3
"""A fake `gh` for the `tt ui` demo: canned GitHub data, no network.

Answers only what the UI asks of `gh`:
  * `gh api graphql ... -f branch=<name>`: the single per-PR lookup (state, CI,
    reviews, review threads, timeline events). Branch names in SCENARIOS below
    have a PR; every other branch has none.
  * `gh api graphql` with a `search(` query and no timeline: the "open PRs
    not tracked by toolbelt" callout; always an empty list here.
  * `gh api graphql` with a `search(` query asking for `timelineItems`: the
    aggregate view's history. Answers with the PRs in `history.json` (written
    next to the demo's TOOLBELT_HOME by seed.py: ~12 weeks of merged/closed
    PRs with absolute timestamps) plus the open PRs of SCENARIOS; a search
    containing `is:open` gets only the open ones.
Timestamps in SCENARIOS are relative to now, so the demo always looks recent.
Anything else exits 1, like `gh pr view` for a branch without a PR.
"""

import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

a = sys.argv[1:]
if a[:2] != ["api", "graphql"]:
    sys.exit(1)
searching = any("search(" in x for x in a)
if searching and not any("timelineItems" in x for x in a):
    print(json.dumps({"data": {"search": {"nodes": [], "issueCount": 0}}}))
    sys.exit(0)
branch = next((x.split("=", 1)[1] for x in a if x.startswith("branch=")), None)
if branch is None and not searching:
    print(json.dumps({"data": {"repository": {"pullRequests": {"nodes": []}}}}))
    sys.exit(0)
NOW = datetime.now(timezone.utc)


def t(**kw):
    return (NOW - timedelta(**kw)).strftime("%Y-%m-%dT%H:%M:%SZ")


def user(login):
    return {"login": login}


def req(login, **kw):
    return {
        "__typename": "ReviewRequestedEvent",
        "createdAt": t(**kw),
        "actor": user("devon"),
        "requestedReviewer": {"__typename": "User", "login": login},
    }


def review(login, st, **kw):
    return {
        "__typename": "PullRequestReview",
        "submittedAt": t(**kw),
        "state": st,
        "author": user(login),
    }


def commit(oid, msg, ci, **kw):
    return {
        "__typename": "PullRequestCommit",
        "commit": {
            "oid": oid,
            "messageHeadline": msg,
            "committedDate": t(**kw),
            "author": {"user": user("devon"), "name": "Devon"},
            "statusCheckRollup": {"state": ci} if ci else None,
        },
    }


def ev(kind, **kw):
    return {"__typename": kind, "createdAt": t(**kw), "actor": user("devon")}


def ctx(c, s="COMPLETED"):
    return {"__typename": "CheckRun", "conclusion": c, "status": s}


def pr(n, title, **o):
    ci = o.pop("ci", "SUCCESS")
    items = o.pop("items", [])
    threads = o.pop("threads", 0)
    reqs = o.pop("reqs", [])
    recent = o.pop("recent", None)
    contexts = {
        "SUCCESS": [ctx("SUCCESS")],
        "FAILURE": [ctx("FAILURE")],
        "RUNNING": [ctx(None, "IN_PROGRESS")],
        None: [],
    }[ci]
    state = {"RUNNING": "PENDING"}.get(ci, ci)
    node = {
        "id": f"PR_kwDEMO{n:06d}",
        "number": n,
        "url": f"https://github.com/devon/demo/pull/{n}",
        "title": title,
        "state": "OPEN",
        "isDraft": False,
        "createdAt": t(days=5),
        "mergedAt": None,
        "closedAt": None,
        "headRefOid": f"{n:07x}",
        "baseRefName": "main",
        "mergeable": "MERGEABLE",
        "reviewDecision": None,
        "author": user("devon"),
        "reviewRequests": {
            "nodes": [
                {"requestedReviewer": {"__typename": "User", "login": r}} for r in reqs
            ]
        },
        "reviewThreads": {
            "nodes": [{"isResolved": False}] * threads + [{"isResolved": True}]
        },
        "head": {
            "nodes": [
                {
                    "commit": {
                        "statusCheckRollup": {
                            "state": state,
                            "contexts": {"nodes": contexts},
                        }
                        if ci
                        else None
                    }
                }
            ]
        },
        "recent": {
            "nodes": recent
            if recent is not None
            else [
                {
                    "commit": {
                        "oid": f"{n:07x}",
                        "statusCheckRollup": {"state": state} if ci else None,
                    }
                }
            ]
        },
        "timelineItems": {"nodes": items},
    }
    node.update(o)
    return node


