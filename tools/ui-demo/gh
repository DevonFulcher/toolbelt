# ---- the aggregate view's history -----------------------------------------------


def history_node(spec):
    """A `search` node for one PR spec of history.json; its events are
    [kind, iso time, ...] (see `history` in seed.py)."""
    items = []
    for kind, when, *rest in spec["events"]:
        if kind == "ready":
            items.append(
                {
                    "__typename": "ReadyForReviewEvent",
                    "createdAt": when,
                    "actor": user("devon"),
                }
            )
        elif kind == "draft":
            items.append(
                {
                    "__typename": "ConvertToDraftEvent",
                    "createdAt": when,
                    "actor": user("devon"),
                }
            )
        elif kind == "request":
            items.append(
                {
                    "__typename": "ReviewRequestedEvent",
                    "createdAt": when,
                    "actor": user("devon"),
                    "requestedReviewer": {"__typename": "User", "login": rest[0]},
                }
            )
        elif kind == "review":
            items.append(
                {
                    "__typename": "PullRequestReview",
                    "submittedAt": when,
                    "state": rest[1],
                    "author": user(rest[0]),
                }
            )
        elif kind == "commit":
            oid, ci, done = rest
            suites = [{"status": "COMPLETED", "updatedAt": done}] if done else []
            items.append(
                {
                    "__typename": "PullRequestCommit",
                    "commit": {
                        "oid": oid,
                        "messageHeadline": "Work",
                        "committedDate": when,
                        "author": {"user": user("devon"), "name": "Devon"},
                        "statusCheckRollup": {"state": ci} if ci else None,
                        "checkSuites": {"nodes": suites},
                    },
                }
            )
        elif kind == "base":
            items.append(
                {
                    "__typename": "BaseRefChangedEvent",
                    "createdAt": when,
                    "previousRefName": rest[0],
                    "currentRefName": rest[1],
                }
            )
        elif kind == "merged":
            items.append(
                {"__typename": "MergedEvent", "createdAt": when, "actor": user("devon")}
            )
            items.append(
                {"__typename": "ClosedEvent", "createdAt": when, "actor": user("devon")}
            )
        elif kind == "closed":
            items.append(
                {"__typename": "ClosedEvent", "createdAt": when, "actor": user("devon")}
            )
    return {
        "id": spec["node_id"],
        "number": spec["number"],
        "title": spec["title"],
        "state": spec["state"],
        "isDraft": spec.get("draft", False),
        "createdAt": spec["created"],
        "mergedAt": spec.get("merged"),
        "closedAt": spec.get("merged") or spec.get("closed"),
        "headRefName": spec["head"],
        "baseRefName": spec.get("base", "main"),
        "reviewDecision": None,
        "author": user("devon"),
        "repository": {"nameWithOwner": f"devon/{spec['repo']}", "isArchived": False},
        "reviewRequests": {"totalCount": 0},
        "timelineItems": {"nodes": items},
    }


def scenario_search_node(head, node):
    repo = "demo-search" if head == "devon/search-index" else "demo-app"
    return {
        **node,
        "headRefName": head,
        "repository": {"nameWithOwner": f"devon/{repo}", "isArchived": False},
        "reviewRequests": {"totalCount": len(node["reviewRequests"]["nodes"])},
    }


if searching:
    history = Path(os.environ.get("TOOLBELT_HOME", ".")).parent / "history.json"
    specs = json.loads(history.read_text()) if history.is_file() else []
    found = [history_node(spec) for spec in specs]
    found += [scenario_search_node(h, n) for h, n in SCENARIOS.items()]
    if any("is:open" in x for x in a):
        found = [n for n in found if n["state"] == "OPEN"]
    page = {
        "issueCount": len(found),
        "pageInfo": {"hasNextPage": False, "endCursor": None},
        "nodes": found,
    }
    print(json.dumps({"data": {"search": page}}))
    sys.exit(0)
nodes = [SCENARIOS[branch]] if branch in SCENARIOS else []
print(json.dumps({"data": {"repository": {"pullRequests": {"nodes": nodes}}}}))
