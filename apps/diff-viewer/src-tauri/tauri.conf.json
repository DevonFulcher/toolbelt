{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diff Viewer",
  "version": "0.1.0",
  "identifier": "dev.devon.diffviewer",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "pnpm --dir web exec vite --port 5273 --strictPort",
    "beforeBuildCommand": "pnpm --dir web build"
  },
  "app": {
    "windows": [{ "title": "Diff Viewer", "width": 1400, "height": 900 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
