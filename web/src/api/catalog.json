      "tone": "red",
      "legend": "A reviewer requested changes."
    },
    "next_resolve_comments": {
      "label": "Resolve comments",
      "tone": "amber",
      "legend": "Unresolved review threads remain."
    },
    "next_resolve_conflicts": {
      "label": "Resolve conflicts",
      "tone": "red",
      "legend": "The PR has merge conflicts."
    },
    "next_wait_ci": {
      "label": "Waiting on CI",
      "tone": "amber",
      "legend": "CI is running."
    },
    "next_fix_ci": {
      "label": "Fix / re-run CI",
      "tone": "red",
