    "next_autonomous": {
      "label": "Autonomous agent",
      "tone": "purple",
      "legend": "One of toolbelt's autonomous agents is working on this task (a claim file; the action it replaced is in the tooltip)."
    },
    "next_deciding": {
      "label": "Deciding",
      "tone": "amber",
      "legend": "An agent asked a question about this task and is waiting for the answer (the action it replaced is in the tooltip)."
    },
    "git_conflicting": {
      "label": "Conflicting",
      "tone": "red",
      "legend": "The PR conflicted with its base, as `tt ui` saw it (the start is when it was first seen)."
    },
    "comments_open": {
      "label": "Unresolved threads",
      "tone": "amber",
      "legend": "The PR had unresolved review threads, as `tt ui` saw (the start is when it was first seen)."
    },
