    "agent_succeeded": {
      "label": "Agent run done",
      "tone": "green",
      "legend": "An autonomous agent run that finished."
    },
    "agent_failed": {
      "label": "Agent run failed",
      "tone": "red",
      "legend": "An autonomous agent run that failed."
    },
    "agent_timed_out": {
      "label": "Agent run timed out",
      "tone": "red",
      "legend": "A run that hit its time limit."
    },
    "agent_cap_reached": {
      "label": "Agent run capped",
