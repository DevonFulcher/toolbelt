  "not_represented": [
    {
      "label": "Comment threads opening or resolving",
      "why": "GitHub has no timeline event for it; only the current unresolved count is shown (Comments, in the Now tooltip)."
    },
    {
      "label": "A PR becoming conflicting",
      "why": "Not an event; only whether it conflicts now is shown (Merge, in the Now tooltip)."
    },
    {
      "label": "CI progress between commits",
      "why": "Only each commit's final result is known; a re-run of the same commit is not an event."
    },
    {
      "label": "When an approval went stale or was dismissed",
      "why": "Inferred: it ends at the first push after it when the PR is not approved now."
    },
    {
      "label": "History of being blocked on a parent",
      "why": "Derived from the parent's state now (Next, in the Now tooltip), not recorded."
    },
    {
      "label": "History of an agent claiming a task",
      "why": "Claims are files with no history: With an agent shows only now, and the aggregate view does not count it (the task is in the state its PR was in)."
    },
    {
      "label": "Conversation comments, edits, labels, assignees",
      "why": "Not review activity; not fetched."
    }
  ]
}
