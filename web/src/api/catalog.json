      "legend": "No PR yet: open one."
    },
    "next_personal_review": {
      "label": "Personal review",
      "tone": "accent",
      "legend": "A validate run reviewed the branch: read its diff, then approve it (which opens the PR) or request changes."
    },
    "next_publish": {
      "label": "Publish PR in GitHub",
      "tone": "accent",
      "legend": "A draft with green CI: mark it ready."
    },
    "next_request_review": {
      "label": "Request review",
      "tone": "accent",
      "legend": "Ready, but nobody was asked to review."
    },
    "next_post_slack": {
      "label": "Post in Slack",
      "tone": "accent",
      "legend": "Ready for review: post it in the review channel in Slack."
    },
    "next_bump_slack": {
      "label": "Bump in Slack",
      "tone": "amber",
      "legend": "Posted in Slack over a day ago and nobody has reviewed or commented: bump it."
    },
    "next_wait_review": {
      "label": "Waiting for review",
      "tone": "gray",
      "legend": "Waiting for a reviewer."
    },
