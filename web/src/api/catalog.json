{
  "events": {
    "started": {
      "label": "Task started",
      "glyph": "◇",
      "tone": "accent",
      "legend": "The task started: its branch was created."
    },
    "opened": {
      "label": "opened",
      "glyph": "◆",
      "tone": "green",
      "legend": "The PR was opened."
    },
    "commit": {
      "label": "commit",
      "glyph": "•",
      "tone": "gray",
      "legend": "A commit was pushed (faint dot)."
    },
    "commits": {
      "label": "commits",
      "glyph": "",
      "tone": "gray",
      "legend": "Several commits close together, grouped (the number is the count)."
    },
    "commit_failed": {
      "label": "commit (CI failed)",
      "glyph": "●",
      "tone": "red",
      "legend": "A commit whose CI ended failing."
    },
    "force_push": {
      "label": "force push",
      "glyph": "↯",
      "tone": "accent",
      "legend": "The branch was force-pushed."
    },
    "review_requested": {
      "label": "review requested",
      "glyph": "▸",
      "tone": "amber",
      "legend": "A review was requested from someone."
    },
    "review_request_removed": {
      "label": "request removed",
      "glyph": "⊘",
      "tone": "amber",
      "legend": "A review request was withdrawn."
    },
    "ready_for_review": {
      "label": "ready for review",
      "glyph": "▶",
      "tone": "green",
      "legend": "The draft was marked ready for review."
    },
    "converted_to_draft": {
      "label": "back to draft",
      "glyph": "◐",
      "tone": "gray",
      "legend": "The PR was converted back to a draft."
    },
    "review_approved": {
      "label": "approved",
      "glyph": "✓",
      "tone": "green",
      "legend": "A reviewer approved."
    },
    "review_changes": {
      "label": "changes requested",
      "glyph": "✗",
      "tone": "red",
      "legend": "A reviewer requested changes."
    },
    "review_commented": {
      "label": "commented",
      "glyph": "✎",
      "tone": "amber",
      "legend": "A reviewer left a review comment."
    },
    "merged": {
      "label": "merged",
      "glyph": "⬤",
      "tone": "purple",
      "legend": "The PR was merged."
    },
    "closed": {
      "label": "closed",
      "glyph": "✕",
      "tone": "red",
      "legend": "The PR was closed without merging."
    },
    "reopened": {
      "label": "reopened",
      "glyph": "↺",
      "tone": "green",
      "legend": "The PR was reopened."
    }
  },
  "phases": {
    "working": {
      "label": "Working (no PR yet)",
      "tone": "accent",
      "legend": "From the task's start until the PR was opened (or until now)."
    },
    "draft": {
      "label": "In draft",
      "tone": "gray",
      "legend": "Not yet ready for review."
    },
    "waiting": {
      "label": "Waiting for review",
      "tone": "amber",
      "legend": "Ready, with a review request outstanding."
    },
    "ci_running": {
      "label": "Waiting on CI",
      "tone": "amber",
      "legend": "From a push until that commit's checks completed, whatever their outcome (CI takes time to run even when it fails)."
    },
    "ci_failing": {
      "label": "CI failing",
      "tone": "red",
      "legend": "From the checks completing with a failure until the next push. (Without a known completion time, from the push.)"
    },
    "approved": {
      "label": "Approved",
      "tone": "green",
      "legend": "From an approving review until merge or now. Ends early at the first push after it when the PR is no longer approved (a stale approval), or when that reviewer then requests changes."
    }
  },
